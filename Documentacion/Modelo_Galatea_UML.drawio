e;fontSize=13;fontStyle=1;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="300" y="1702" width="25" height="22" as="geometry" /></mxCell><mxCell id="a167" value="0..1" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=13;fontStyle=1;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="408" y="1676" width="47" height="22" as="geometry" /></mxCell><mxCell id="a168" value="tiene ▸" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=12;fontStyle=2;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="340" y="1675" width="65" height="22" as="geometry" /></mxCell><mxCell id="a169" style="html=1;rounded=0;exitX=1.000;exitY=0.750;exitDx=0;exitDy=0;entryX=0.000;entryY=0.690;entryDx=0;entryDy=0;endArrow=none;startArrow=none;" edge="1" parent="1" source="a56" target="a38"><mxGeometry width="50" height="50" relative="1" as="geometry"><Array as="points"><mxPoint x="990" y="1738" /><mxPoint x="990" y="1285" /></Array></mxGeometry></mxCell><mxCell id="a170" value="0..1" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=13;fontStyle=1;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="676" y="1714" width="47" height="22" as="geometry" /></mxCell><mxCell id="a171" value="*" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=13;fontStyle=1;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1084" y="1261" width="25" height="22" as="geometry" /></mxCell><mxCell id="a172" value="carga ▴" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=12;fontStyle=2;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1004" y="1672" width="65" height="22" as="geometry" /></mxCell><mxCell id="a173" style="html=1;rounded=0;exitX=0.400;exitY=1.000;exitDx=0;exitDy=0;entryX=0.458;entryY=1.000;entryDx=0;entryDy=0;endArrow=none;startArrow=none;" edge="1" parent="1" source="a56" target="a46"><mxGeometry width="50" height="50" relative="1" as="geometry"><Array as="points"><mxPoint x="538" y="2470" /><mxPoint x="1640" y="2470" /></Array></mxGeometry></mxCell><mxCell id="a174" value="1" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=13;fontStyle=1;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="510" y="1768" width="25" height="22" as="geometry" /></mxCell><mxCell id="a175" value="*" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=13;fontStyle=1;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1644" y="2030" width="25" height="22" as="geometry" /></mxCell><mxCell id="a176" value="crea ▸" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=12;fontStyle=2;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1000" y="2446" width="58" height="22" as="geometry" /></mxCell><mxCell id="a185" value="&lt;b&gt;Restricciones&lt;/b&gt;&lt;ol style=&quot;margin-top:6px&quot;&gt;&lt;li&gt;Derivados (/): fechaHoraFin = fechaHoraInicio + duración según cantidadPersonas (60 min hasta 2 personas, 90 hasta 4, 150 hasta 8, 180 para más). Mesa.estado = cuentaSolicitada si tiene una Cuenta abierta con fechaSolicitudCuenta; ocupada si tiene una Cuenta abierta; reservada si no tiene Cuenta abierta y tiene una Reserva confirmada que empieza dentro de los próximos 30 min o empezó hace menos de 10 min; libre en cualquier otro caso. Cuenta.subtotal = Σ(cantidad × precioUnitario) de los DetallePedido de sus Pedidos; descuento = subtotal × porcentaje/100 del cupón aplicado (0 si no hay); total = subtotal − descuento. CuponDescuento.estado = usado si está aplicado a una Cuenta.&lt;/li&gt;&lt;li&gt;Cliente: telefono es único; nombre y telefono se completan al registrarse para el descuento de bienvenida. Si el teléfono ya pertenece a otro Cliente, ambos se fusionan en uno solo. HuellaDispositivo.hash es único.&lt;/li&gt;&lt;li&gt;Una Mesa no puede estar asignada a dos Reservas confirmadas cuyos horarios se superpongan. La suma de capacidades de las Mesas asignadas a una Reserva debe ser ≥ cantidadPersonas. cantidadPersonas &amp;gt; 0.&lt;/li&gt;&lt;li&gt;Una Reserva pasa a no_show si entre 15 min antes y 10 min después de fechaHoraInicio no se escaneó el QR de su Mesa ni se abrió una Cuenta en ella. Si se concreta, la Cuenta es de una de las Mesas asignadas a esa Reserva.&lt;/li&gt;&lt;li&gt;Mesa: numero y codigoQR son únicos; capacidad &amp;gt; 0. Una Mesa tiene a lo sumo una Cuenta abierta.&lt;/li&gt;&lt;li&gt;Cuenta: fechaCierre y el UsuarioInterno que la cierra existen solo si estado = cerrada. fechaSolicitudCuenta (el Cliente pidió la cuenta desde la app) es posterior a fechaApertura. Quien la cierra es un UsuarioInterno cuyo Empleado tiene Cargo Mozo, Bartender o Administrador (nunca Cocinero).&lt;/li&gt;&lt;li&gt;Pedido: solo se registra en una Cuenta abierta. Lo que el Cliente pide en una misma confirmación se divide en un Pedido por sector: el sector de cada DetallePedido es el de la CategoriaMenu de su Producto. Si canal = asistido lo carga un UsuarioInterno con Cargo Mozo; si canal = qr no tiene Mozo y siempre tiene Cliente (anónimo, identificado por su HuellaDispositivo, o registrado). estado avanza pendiente → preparacion → listo → entregado; solo un usuario con Cargo Mozo lo marca entregado.&lt;/li&gt;&lt;li&gt;DetallePedido: se refiere a una Presentacion disponible de un Producto activo; cantidad &amp;gt; 0; precioUnitario es el precio de la Presentacion al momento de pedir.&lt;/li&gt;&lt;li&gt;Menú: CategoriaMenu.nombre es único y su sector (cocina o barra) define a dónde van los pedidos de sus Productos. Producto.nombre es único dentro de su CategoriaMenu; todo Producto tiene al menos una Presentacion. Presentacion.nombre es único dentro de su Producto ('Estándar' si hay un solo precio); precio ≥ 0. Un Producto se muestra 'Agotado por hoy' cuando ninguna de sus Presentaciones está disponible; la disponibilidad la cambia una persona. Un Producto de una categoría de cocina lo crea un usuario con Cargo Cocinero o Administrador; uno de barra, Bartender o Administrador. Etiqueta.nombre es único; solo se asignan las etiquetas que indica el restaurante (ej. vegetariano, sin gluten, sin alcohol).&lt;/li&gt;&lt;li&gt;Recomendacion: se refiere a un Producto; 0 ≤ relevancia ≤ 1 (qué tan probable es que le guste al Cliente; se usa para ordenar y descartar); aceptada = true si el Cliente terminó pidiendo el Producto recomendado.&lt;/li&gt;&lt;li&gt;UsuarioInterno: usuario es único; la contraseña se guarda cifrada (hash). Cada Empleado tiene a lo sumo un UsuarioInterno; si cambia de Cargo conserva el mismo usuario.&lt;/li&gt;&lt;li&gt;Empleado y Cargo: Empleado.cedula es única y Cargo.nombre es único. El Cargo es el puesto laboral (lo administra el Administrador, ej. Bachero o Portero) y también define el acceso al sistema: solo los Empleados con Cargo Administrador, Mozo, Cocinero o Bartender pueden tener UsuarioInterno, y esos cuatro cargos no se pueden renombrar ni eliminar. Los demás cargos no tienen acceso al sistema. Solo un Empleado activo puede tener un UsuarioInterno activo.&lt;/li&gt;&lt;li&gt;CuponDescuento: codigoQR es único; 0 &amp;lt; porcentaje ≤ 100 (bienvenida = 10); es de un solo uso; cada Cliente tiene a lo sumo un cupón de tipo bienvenida; fechaUso existe solo si está aplicado a una Cuenta, y solo se aplica al cerrarla.&lt;/li&gt;&lt;/ol&gt;" style="shape=note;whiteSpace=wrap;html=1;size=18;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="2550" width="2530" height="520" as="geometry" /></mxCell><mxCell id="m_pres" value="Presentacion" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1110" y="1900" width="240" height="122" as="geometry" /></mxCell><mxCell id="m_pres_0" value="nombre: String" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;" vertex="1" parent="m_pres"><mxGeometry y="34" width="240" height="22" as="geometry" /></mxCell><mxCell id="m_pres_1" value="precio: Real" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;" vertex="1" parent="m_pres"><mxGeometry y="56" width="240" height="22" as="geometry" /></mxCell><mxCell id="m_pres_2" value="orden: Entero" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;" vertex="1" parent="m_pres"><mxGeometry y="78" width="240" height="22" as="geometry" /></mxCell><mxCell id="m_pres_3" value="disponible: Booleano" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;" vertex="1" parent="m_pres"><mxGeometry y="100" width="240" height="22" as="geometry" /></mxCell><mxCell id="m_cat" value="CategoriaMenu" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;hori