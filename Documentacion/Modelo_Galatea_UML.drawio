ex="1" parent="b4"><mxGeometry y="34" width="230" height="22" as="geometry" /></mxCell><mxCell id="b6" value="puntosRequeridos: Entero" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;" vertex="1" parent="b4"><mxGeometry y="56" width="230" height="22" as="geometry" /></mxCell><mxCell id="b7" value="activo: Booleano" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;" vertex="1" parent="b4"><mxGeometry y="78" width="230" height="22" as="geometry" /></mxCell><mxCell id="b8" value="Cliente" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="140" y="450" width="240" height="60" as="geometry" /></mxCell><mxCell id="b9" value="(atributos en la página Gestión)" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontStyle=2;" vertex="1" parent="b8"><mxGeometry y="34" width="240" height="22" as="geometry" /></mxCell><mxCell id="b10" value="Jugador" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="785" y="428" width="230" height="104" as="geometry" /></mxCell><mxCell id="b11" value="rol: RolJuego [0..1]" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacin