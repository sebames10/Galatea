# Copiá este archivo como .env y completá los valores.

# --- Servidor ---
PORT=3000
# Orígenes que pueden llamar a la API (el frontend de Vite). Separados por coma.
CORS_ORIGIN=http://localhost:5173

# --- Base de datos (PostgreSQL 15+, local o el Postgres de Supabase) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/galatea
# Schema donde viven las tablas. db:reset lo borra y lo vuelve a crear, nunca toca "public".
DB_SCHEMA=galatea
# Zona horaria del restaurante: las fechas se guardan sin zona (TIMESTAMP) en hora de Montevideo.
DB_TIMEZONE=America/Montevideo
# true para Supabase u otro Postgres en la nube
DATABASE_SSL=false

# --- Autenticación ---
# Cadena larga y aleatoria. Generala con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambiar-por-una-cadena-larga-y-aleatoria
JWT_EXPIRES_IN=12h

# --- Supabase Storage (fotos de productos y empleados) ---
# Settings > API en el panel de Supabase. La service_role key va SOLO en el backend, nunca en el frontend.
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=galatea

# --- FLUX (Black Forest Labs): solo para "npm run fotos:generar" ---
# dashboard.bfl.ai > API keys. La API no la usa al correr.
BFL_API_KEY=
FLUX_MODEL=flux-pro-1.1

# --- QR de las mesas: solo para "npm run qr:mesas" ---
# URL pública del frontend. Cada QR apunta a <WEB_URL>/?mesa=<código>. Sin valor usa la IP local:5173.
WEB_URL=
